<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <it.dhd.oneplusui.preference.OplusPreferenceCategory />

    <it.dhd.oneplusui.preference.OplusSwitchPreference
        android:key="launcher_custom_search_switch"
        android:title="@string/custom_global_search"
        app:forcePosition="full"
        app:iconSpaceReserved="false" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory />

    <it.dhd.oxygencustomizer.ui.preferences.TopIntroPreference android:title="@string/custom_global_search_explaination" />

    <it.dhd.oneplusui.preference.OplusPreferenceCategory android:key="behavior_category">

        <it.dhd.oneplusui.preference.OplusListPreference
            android:defaultValue="app:it.dhd.oxygencustomizer"
            android:entries="@array/launcher_global_search_intent_entries"
            android:entryValues="@array/launcher_global_search_intent_values"
            android:key="launcher_global_search_launch"
            android:title="@string/custom_global_search_action"
            app:iconSpaceReserved="false" />

    </it.dhd.oneplusui.preference.OplusPreferenceCategory>

</PreferenceScreen>